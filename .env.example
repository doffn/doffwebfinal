# Required for production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.com,.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://your-project.vercel.app

# Telegram bot configuration — SERVER SIDE ONLY; never put these in HTML or JS.
TELEGRAM_BOT_TOKEN=123456789:replace_with_real_bot_token
# Public channel username such as @your_channel OR numeric channel ID like -1001234567890
TELEGRAM_CHAT_ID=@your_channel_username
# Optional reference for deployment setup; give the bot administrator permission to post messages/media.
TELEGRAM_CHANNEL_ADMIN_REQUIRED=true
